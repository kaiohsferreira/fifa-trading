{
  "mcpServers": {
    "gemini": {
      "command": "npx",
      "args": ["-y", "@google/gemini-cli", "mcp"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "codex": {
      "command": "codex",
      "args": ["--mcp-server"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      }
